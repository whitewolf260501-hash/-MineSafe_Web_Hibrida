# PORT: HTTP port for the Express + Vite server (default 3000).
PORT="3000"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ============================================================================
# VARIABLES PÚBLICAS DE CLIENTE (Prefijo VITE_ — incluidas en el bundle web)
# Nota: La apiKey / databaseURL de Firebase Web NO son secretos privados;
# la seguridad depende de Firebase Auth + Security Rules + App Check.
# ============================================================================
VITE_FIREBASE_RTDB_URL="https://TU-PROYECTO-default-rtdb.firebaseio.com/"

# ============================================================================
# CONTACTO PÚBLICO PORTADA P013 (Público)
# ============================================================================
VITE_PUBLIC_CONTACT_EMAIL="minesafe99@gmail.com"
# VITE_PUBLIC_CONTACT_ENDPOINT=""

# ============================================================================
# CREDENCIALES PRIVADAS SOLO SERVIDOR / SCRIPTS BACKEND (NUNCA usar prefijo VITE_)
# ============================================================================
# Token secreto servidor para POST /api/telemetry/ingest (OWASP ASVS · IEC 62443)
INGEST_API_TOKEN=""
INGEST_RATE_LIMIT_MAX="60"
INGEST_RATE_LIMIT_WINDOW_MS="60000"

# URL RTDB y credencial administrativa usada únicamente por scripts server-side
# (ej. scripts/migrateLegacyOrganization.ts). NUNCA exponer en frontend ni Git.
FIREBASE_RTDB_URL=""
# Preferir OAuth2 / Admin SDK / Custom Token de vida corta:
FIREBASE_AUTH_TOKEN=""
# LEGACY / DEPRECADO (migrar fuera de Database Secrets):
FIREBASE_DB_SECRET=""
