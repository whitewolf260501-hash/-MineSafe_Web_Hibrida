rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isPrimarySuperAdmin() {
      return request.auth != null && request.auth.token.email == 'manuelcrisostomovega@gmail.com';
    }

    function isValidScopeSegment(val, maxLen) {
      return val is string && val.size() >= 3 && val.size() <= maxLen && val.matches('^[a-zA-Z0-9_-]+$');
    }

    function isAllowedAttachmentMime(contentType) {
      return contentType is string && contentType.matches('image/(jpeg|png|webp)|application/pdf');
    }

    // Ruta canónica multiempresa: /adjuntos/{organizationId}/{alertId}/{fileName}
    match /adjuntos/{organizationId}/{alertId}/{fileName} {
      allow read: if request.auth != null
        && (
          isPrimarySuperAdmin()
          || (
            request.auth.token.organizationId != null
            && request.auth.token.organizationId == organizationId
          )
          || (
            request.auth.token.organizationId == null
            && resource != null
            && resource.metadata['organizationId'] == organizationId
          )
        );

      allow create: if request.auth != null
        && isValidScopeSegment(organizationId, 64)
        && isValidScopeSegment(alertId, 128)
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && isAllowedAttachmentMime(request.resource.contentType)
        && request.resource.metadata['organizationId'] == organizationId
        && request.resource.metadata['alertId'] == alertId
        && request.resource.metadata['uploadedByUid'] == request.auth.uid
        && (
          isPrimarySuperAdmin()
          || request.auth.token.organizationId == null
          || request.auth.token.organizationId == organizationId
        );

      // Inmutabilidad de evidencia: no sobrescribir archivos existentes
      allow update: if false;

      allow delete: if request.auth != null
        && resource != null
        && (
          isPrimarySuperAdmin()
          || (
            resource.metadata['uploadedByUid'] == request.auth.uid
            && (
              request.auth.token.organizationId == null
              || request.auth.token.organizationId == organizationId
            )
          )
        );
    }

    // Bloqueo de ruta plana legada /adjuntos/{alertId}/{fileName} para nuevas escrituras
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
