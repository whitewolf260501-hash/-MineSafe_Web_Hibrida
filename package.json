{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "sync:docs": "node scripts/syncDocsManifest.mjs",
    "sync:pages": "node scripts/syncStaticPages.mjs",
    "prebuild": "npm run sync:docs",
    "build": "vite build && rm -rf dist/assets/aistudio dist/minesafe-web*.zip && npm run sync:pages",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:alerts": "tsx tests/test_alert_engine.ts",
    "test:p013": "tsx tests/test_p013_access_and_landing.ts",
    "test:audit": "tsx tests/test_audit_stabilization.ts",
    "test:p031": "tsx tests/test_p031_comprehensive.ts",
    "test:p085": "tsx tests/test_p085_security_rules_and_credentials.ts",
    "test:rules": "eslint firestore.rules && node -e \"JSON.parse(require('fs').readFileSync('database.rules.json','utf8')); console.log('database.rules.json OK');\"",
    "validate:firebase": "npm run test:rules && node -e \"JSON.parse(require('fs').readFileSync('firebase.json','utf8')); console.log('firebase.json OK');\"",
    "test": "npm run test:alerts && npm run test:p013 && npm run test:audit && npm run test:p031 && npm run test:p085"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.15.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
